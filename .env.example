# Flask Configuration
SECRET_KEY=change-this-to-a-very-secure-random-secret-key
FLASK_ENV=development
FLASK_DEBUG=1
APP_URL=http://localhost:5000

# Database Configuration
# Default uses SQLite inside instance/complaints.db
DATABASE_URL=sqlite:///complaints.db

# Default Admin Credentials (Auto-created on first run if not existing)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin123
ADMIN_DEFAULT_EMAIL=admin@smartcampus.edu

# SMTP Email Configuration (Optional - for admin notifications)
# Leave MAIL_USERNAME blank to disable actual SMTP sending (logs notification to console instead)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=complaints@smartcampus.edu
ADMIN_NOTIFICATION_EMAIL=admin@smartcampus.edu
